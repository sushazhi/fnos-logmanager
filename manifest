appname = logmanager
version = 0.8.1.10
display_name = 飞牛日志管理
desc = <b>飞牛日志管理工具</b>，集中管理飞牛三方应用散落在各个文件夹的日志文件。<br><br>🌐 <b>统一网关接入：</b><br>- 通过 fnOS 统一网关访问，无需独立端口<br>- 网关自动校验登录态，免密码登录<br>- 原生 WebSocket 实时通信<br><br>📁 <b>多标签页日志查看：</b><br>- 同时打开多个日志文件，标签栏切换<br>- 深色终端风格显示，关键词/正则搜索高亮<br>- 日志实时追踪<br>- 多格式导出(TXT/JSON/CSV)<br><br>📁 <b>支持的日志目录：</b><br>- 存储空间应用日志 (@appdata/@appshare等)<br>- /var/log/apps/ (系统应用日志)<br>- Docker容器日志<br>- 归档日志文件(.gz, .bz2, .xz, .zip等)<br><br>🔔 <b>通知推送(22种渠道)：</b><br>- Bark/钉钉/钉钉应用/飞书/企业微信/Telegram/QQ机器人/微信ClawBot等<br>- 钉钉应用支持扫码创建，自动获取凭据<br>- 自定义监控规则，关键词匹配（支持正则）<br>- 冷却时间与静默时段设置<br><br>⚙️ <b>管理功能：</b><br>- 定时自动清理策略(cron/自定义间隔)<br>- 日志书签收藏，快速访问<br>- 清理已卸载应用空文件夹<br>- 日志备份与归档<br>- 系统事件监控与审计日志<br><br>🎨 <b>UI风格：</b><br>- 鸿蒙 7.0 液态玻璃(Liquid Glass)设计体系<br>- 完整设计令牌系统、空间化3D景深阴影、动态光效<br>- 统一过渡曲线与聚焦环、空间化变换<br>- 深色终端/日间夜间主题/自定义主题色<br><br>🐛 <b>问题反馈：</b><a href="https://github.com/sushazhi/fnos-logmanager/issues" target="_blank">GitHub Issues</a>

# 系统要求
platform = all
os_min_version = 1.2.0401
source = thirdparty

# 开发者信息
maintainer = yukihana
maintainer_url = https://github.com/sushazhi

distributor = yukihana
distributor_url = https://github.com/sushazhi/fnos-logmanager

# 安装控制
ctl_stop = true

# 依赖
install_dep_apps = 

# 桌面图标配置
desktop_uidir = ui
desktop_applaunchname = logmanager.Application

# 启用前端 JS SDK 支持
micro_app = true

changelog = v0.8.2<br>1. 新增「系统空间清理」：可视化展示磁盘与各分区占用，按分类清理可再生缓存，支持试运行预估可释放空间<br>2. 15 个清理分类，其中新增系统分区的包缓存、系统日志与 dpkg 升级残留（此前只能手工处理）<br>3. 系统分区采用更严格防护：绝对路径规则表 + 兜底拒绝名单 + 符号链接零容忍；正在写入的日志一律截断而非删除<br>4. 内核清理补齐 /usr/lib/linux-image-* 设备树目录，并提示「只删文件、不经包管理器」及收尾用的 apt purge 命令<br>5. 首页功能入口按「日志查看 / 空间与清理 / 系统与设置」三组归类<br>6. 系统空间清理改为持久化快照：扫描结果落盘并后台定期刷新，重开面板、重启或升级应用都不再等待全量扫描；数据超过 5 分钟会在返回旧数据的同时后台更新，面板自动收敛<br>7. 磁盘列表只显示真实挂载点，不再出现 /vol00、/vol02 这类与系统空间重复的目录；外接存储不再出现在系统空间清理中（清理规则本就不扫外接盘，外接盘的空间请看飞牛存储管理）<br>问题反馈：<a href="https://github.com/sushazhi/fnos-logmanager/issues" target="_blank">GitHub Issues</a>